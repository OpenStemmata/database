<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d3" for="edge" attr.name="cert" attr.type="string"/>
<key id="d2" for="edge" attr.name="type" attr.type="string"/>
<key id="d1" for="node" attr.name="label" attr.type="string"/>
<key id="d0" for="node" attr.name="color" attr.type="string"/>
<graph edgedefault="directed"><node id="Lambda">
  <data key="d0">grey</data>
</node>
<node id="x">
  <data key="d0">grey</data>
  <data key="d1">(x)</data>
</node>
<node id="y">
  <data key="d0">grey</data>
  <data key="d1">(y)</data>
</node>
<node id="Cprime">
  <data key="d1">C'</data>
</node>
<node id="O"/>
<node id="A"/>
<node id="R"/>
<node id="L"/>
<node id="V"/>
<node id="C"/>
<edge source="Lambda" target="O">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="Lambda" target="x">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="Lambda" target="y">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="x" target="A">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="y" target="R">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="y" target="Cprime">
  <data key="d2">contamination</data>
  <data key="d3">unknown</data>
</edge>
<edge source="y" target="V">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="Cprime" target="L">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="V" target="C">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="C" target="Cprime">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
</graph></graphml>