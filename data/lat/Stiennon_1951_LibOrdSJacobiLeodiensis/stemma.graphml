<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d2" for="edge" attr.name="cert" attr.type="string"/>
<key id="d1" for="edge" attr.name="type" attr.type="string"/>
<key id="d0" for="node" attr.name="color" attr.type="string"/>
<graph edgedefault="directed"><node id="X">
  <data key="d0">grey</data>
</node>
<node id="Y">
  <data key="d0">grey</data>
</node>
<node id="P"/>
<node id="T"/>
<node id="G"/>
<node id="L"/>
<node id="F"/>
<node id="U"/>
<edge source="X" target="T">
  <data key="d1">filiation</data>
  <data key="d2">unknown</data>
</edge>
<edge source="X" target="G">
  <data key="d1">filiation</data>
  <data key="d2">unknown</data>
</edge>
<edge source="X" target="L">
  <data key="d1">filiation</data>
  <data key="d2">unknown</data>
</edge>
<edge source="Y" target="F">
  <data key="d1">filiation</data>
  <data key="d2">unknown</data>
</edge>
<edge source="P" target="X">
  <data key="d1">filiation</data>
  <data key="d2">unknown</data>
</edge>
<edge source="P" target="Y">
  <data key="d1">filiation</data>
  <data key="d2">unknown</data>
</edge>
<edge source="F" target="U">
  <data key="d1">filiation</data>
  <data key="d2">unknown</data>
</edge>
</graph></graphml>