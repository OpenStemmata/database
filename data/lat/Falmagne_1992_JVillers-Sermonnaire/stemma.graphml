<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d3" for="edge" attr.name="cert" attr.type="string"/>
<key id="d2" for="edge" attr.name="type" attr.type="string"/>
<key id="d1" for="node" attr.name="label" attr.type="string"/>
<key id="d0" for="node" attr.name="color" attr.type="string"/>
<graph edgedefault="directed"><node id="x1">
  <data key="d0">grey</data>
  <data key="d1">x1</data>
</node>
<node id="x2">
  <data key="d0">grey</data>
  <data key="d1">x2</data>
</node>
<node id="x3">
  <data key="d0">grey</data>
  <data key="d1">x3</data>
</node>
<node id="I">
  <data key="d1">I</data>
</node>
<node id="T">
  <data key="d1">T</data>
</node>
<node id="C">
  <data key="d1">C</data>
</node>
<node id="O">
  <data key="d1">O</data>
</node>
<node id="B">
  <data key="d1">B</data>
</node>
<edge source="x1" target="I">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="x1" target="x2">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="x2" target="T">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="x2" target="C">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="x2" target="x3">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="x3" target="O">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
<edge source="x3" target="B">
  <data key="d2">filiation</data>
  <data key="d3">unknown</data>
</edge>
</graph></graphml>